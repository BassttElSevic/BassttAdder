set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE10F17C8
set_global_assignment -name TOP_LEVEL_ENTITY fpgatest
set_global_assignment -name VERILOG_FILE fpgatest.v
set_global_assignment -name SDC_FILE fpgatest.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_location_assignment PIN_E1  -to clk
set_location_assignment PIN_L3  -to keys[0]
set_location_assignment PIN_L1  -to keys[1]
set_location_assignment PIN_J6  -to keys[2]
set_location_assignment PIN_N1  -to keys[3]
set_location_assignment PIN_T12 -to leds_output[0]
set_location_assignment PIN_P8  -to leds_output[1]
set_location_assignment PIN_M8  -to leds_output[2]
set_location_assignment PIN_M10 -to leds_output[3]

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
